<Window x:Class="AntSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Симулятор муравья" Width="1120" Height="760"
        MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="#F5F7F3" FontFamily="Segoe UI" Foreground="#21352D">
    <Grid Margin="36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="СИМУЛЯЦИЯ МУРАВЬЯ ЛЕНГТОНА" FontSize="10" FontWeight="Bold"
                           Foreground="#739184" Margin="0,0,0,8"/>
                <TextBlock Text="Симулятор муравья" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Наблюдайте, как простые действия создают сложные узоры."
                           FontSize="14" Foreground="#82918A" Margin="0,8,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E6F0E9"
                    CornerRadius="15" Padding="12,7">
                <TextBlock Text="МУРАВЕЙ ЛЕНГТОНА" Foreground="#4C7861" FontSize="10" FontWeight="Bold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="18" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Игровое поле" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Мир муравья в движении" Foreground="#93A198" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="FieldSizeText" Text="45 на 45" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#91A097" FontSize="12"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#F8FAF7" CornerRadius="8" ClipToBounds="True">
                        <Viewbox Stretch="Uniform" Margin="8">
                            <Canvas x:Name="Field" Width="540" Height="540" Background="White"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <Ellipse Width="8" Height="8" Fill="#69A17B" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Готов к запуску" FontSize="12" Foreground="#819188"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="White" CornerRadius="18" Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Управление" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Создайте поле и запустите симуляцию."
                                       TextWrapping="Wrap" FontSize="12" Foreground="#92A098" Margin="0,8,0,16"/>
                            <Button Content="Сгенерировать" Click="Generate_Click" Margin="0,0,0,8"/>
                            <Button x:Name="StartButton" Content="Запустить" Click="Start_Click"
                                    Background="#477B5D" Foreground="White" Margin="0,0,0,8"/>
                            <Button x:Name="PauseButton" Content="Пауза" Click="Pause_Click" IsEnabled="False"/>
                            <Border Background="#F5F8F4" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                                <Grid>
                                    <TextBlock Text="СДЕЛАНО ШАГОВ" FontSize="10" FontWeight="Bold"
                                               Foreground="#91A198" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StepsText" Text="0" HorizontalAlignment="Right"
                                               FontSize="19" FontWeight="Bold" Foreground="#477B5D"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="18" Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Настройки" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Размер поля (от 5 до 100)" FontSize="12" Margin="0,16,0,8"/>
                            <TextBox x:Name="SizeInput" Text="45" Padding="10,8" BorderBrush="#D8E3DA"/>
                            <TextBlock Text="На белой клетке" FontSize="12" Margin="0,16,0,8"/>
                            <ComboBox x:Name="WhiteTurn" SelectedIndex="1" Padding="8,6">
                                <ComboBoxItem Content="Повернуть налево"/>
                                <ComboBoxItem Content="Повернуть направо"/>
                                <ComboBoxItem Content="Идти прямо"/>
                                <ComboBoxItem Content="Развернуться"/>
                            </ComboBox>
                            <TextBlock Text="На чёрной клетке" FontSize="12" Margin="0,16,0,8"/>
                            <ComboBox x:Name="BlackTurn" SelectedIndex="0" Padding="8,6">
                                <ComboBoxItem Content="Повернуть налево"/>
                                <ComboBoxItem Content="Повернуть направо"/>
                                <ComboBoxItem Content="Идти прямо"/>
                                <ComboBoxItem Content="Развернуться"/>
                            </ComboBox>
                            <Button Content="Применить настройки" Click="ApplySettings_Click" Margin="0,16,0,0"/>
                            <TextBlock x:Name="SettingsMessage" Text="Применение создаст поле заново." TextWrapping="Wrap"
                                       FontSize="12" Foreground="#72877B" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#E8F0E9" CornerRadius="18" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Как это работает" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Муравей меняет цвет клетки и делает шаг вперёд. Действия для каждого цвета можно выбрать в настройках."
                                       TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="#72877B" Margin="0,8,0,16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Text="СИМУЛЯТОР МУРАВЬЯ ЛЕНГТОНА"
                   HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="10"
                   FontWeight="Bold" Foreground="#B1BDB5"/>
    </Grid>
</Window>
